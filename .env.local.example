# Образец .env.local. Скопируйте в .env.local и заполните. Реальные значения в git НЕ коммитить.

# --- Обязательно ---
# Рабочая база (локально — своя, на сервере — боевая)
DATABASE_URL=postgresql://mathapp:mathapp@localhost:5432/mathapp_dev
# Отдельная тестовая база для npm run test:db / npm test. Имя ОБЯЗАНО содержать «test».
TEST_DATABASE_URL=postgresql://mathapp:mathapp@localhost:5432/mathapp_test
# Секрет подписи сессий (JWT), длинная случайная строка
SESSION_SECRET=
# Адрес сайта (ссылки в письмах, Telegram, оплате)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Необязательно (без них соответствующая функция просто выключена) ---
# Почта (подтверждение email, сброс пароля, письма родителям)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Telegram-бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_CHAT_ID=
# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_PRICE_RUB=249
YOOKASSA_PERIOD_DAYS=30
# Кто админ платформы (email)
ADMIN_EMAIL=
# Секрет для /api/cron/*
CRON_SECRET=
# Яндекс Метрика
NEXT_PUBLIC_YM_COUNTER_ID=
